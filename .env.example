# Which LibraryProvider to use: demo | http | s3
LIBRARY_PROVIDER=demo

# --- HTTP adapter (your existing catalog / playback API) ---
# Base URL of your library API (no trailing slash)
LIBRARY_API_URL=
# Header name sent to your API (default Authorization)
LIBRARY_AUTH_HEADER=Authorization
# Header value, e.g. "Bearer <token>" or a raw API key
LIBRARY_API_KEY=
# Optional path overrides if your routes differ from the AgmPlay contract
LIBRARY_PATH_CATALOG=/catalog
LIBRARY_PATH_TITLE=/catalog/:id
LIBRARY_PATH_PLAYBACK=/playback/:id
LIBRARY_PATH_SEARCH=/search

# --- S3 / R2 / public-prefix adapter ---
# JSON manifest describing titles + object keys or absolute playback URLs
LIBRARY_MANIFEST_URL=
# Public base for objects, e.g. https://<account>.r2.cloudflarestorage.com/<bucket>
# or a public CDN prefix. Combined with source keys in the manifest.
LIBRARY_PUBLIC_BASE=

# Ads (stub today; later swap for VAST/VMAP or a real SSAI vendor)
ADS_ENABLED=true

# Set automatically by `npm run export:githack` — do not use on Vercel
# STATIC_CDN=https://raw.githack.com/AgmAtk03/agmplay/live-demo
# NEXT_PUBLIC_STATIC_PAGES=1
